{
  "name": "projeto-produtos-fullstack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node server/index.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "build:frontend": "vite build --config frontend/vite.config.js",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "vite build --config frontend/vite.config.js",
    "pretest": "node scripts/check-dependencies.js",
    "prebuild": "node scripts/check-dependencies.js",
    "validate": "npm test && npm run build",
    "check:deps": "node scripts/check-dependencies.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "sql.js": "^1.13.0"
  },
  "stackblitz": {
    "startCommand": "npm start"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
